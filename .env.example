# Conexión agrupada de Neon para la aplicación; nunca NEXT_PUBLIC_.
DATABASE_URL=
# Conexión directa Neon para migraciones (sin -pooler).
MIGRATION_DATABASE_URL=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=
OWNER_EMAIL=docente@example.com
APP_URL=http://127.0.0.1:3000
APP_TIMEZONE=America/Santo_Domingo
# Solo para datos ficticios en este equipo. Render lo rechaza.
DEMO_MODE=false
# Opcional; solo se usa si DEMO_MODE=true fuera de Render.
DEMO_DATABASE_PATH=demo-postgres
